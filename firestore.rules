
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 1. AUTHENTICATION AND ROLES
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    // Only approved veterinarians can manage clinical data.
    function isVet() {
      return signedIn()
      && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      )
      && get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == "veterinarian"
      && get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.vetApproved == true;
    }

    function isPetOwner() {
      return signedIn()
      && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      )
      && get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == "pet_owner";
    }

    // Firebase Auth must confirm ownership of the email.
    function hasVerifiedEmail() {
      return signedIn()
      && request.auth.token.email_verified == true
      && request.auth.token.email is string;
    }

    function isIntendedOwner(email) {
      return isPetOwner()
      && hasVerifiedEmail()
      && email is string
      && request.auth.token.email.lower() == email;
    }

    function vetOwnsPet(patientId) {
      return isVet()
      && exists(
        /databases/$(database)/documents/pets/$(patientId)
      )
      && get(
        /databases/$(database)/documents/pets/$(patientId)
      ).data.vetId == request.auth.uid;
    }

    function ownerOwnsPet(patientId) {
      return isPetOwner()
      && exists(
        /databases/$(database)/documents/pets/$(patientId)
      )
      && get(
        /databases/$(database)/documents/pets/$(patientId)
      ).data.get("ownerId", "") == request.auth.uid;
    }

    // =====================================================
    // 2. PAYMENT INTEGRITY HELPERS
    // =====================================================

    // Every bill balance increase must correspond to a
    // newly created payment in the same transaction.
    function validBillPaymentUpdate(billId) {
      let paymentId = request.resource.data.lastPaymentId;

      let paymentPath =
      /databases/$(database)/documents/bills/$(billId)/payments/$(paymentId);

      return paymentId is string
      && paymentId.size() > 0
      && paymentId != resource.data.get("lastPaymentId", "")
      && !exists(paymentPath)
      && existsAfter(paymentPath)
      && getAfter(paymentPath).data.id == paymentId
      && getAfter(paymentPath).data.billId == billId
      && getAfter(paymentPath).data.vetId == request.auth.uid
      && getAfter(paymentPath).data.method ==
      request.resource.data.paymentMethod
      && getAfter(paymentPath).data.createdAt ==
      request.resource.data.updatedAt
      && getAfter(paymentPath).data.amount > 0
      && request.resource.data.amountPaid - resource.data.amountPaid
      > getAfter(paymentPath).data.amount - 0.000001
      && request.resource.data.amountPaid - resource.data.amountPaid
      < getAfter(paymentPath).data.amount + 0.000001;
    }

    function validPaymentCreation(billId, paymentId) {
      let billPath =
      /databases/$(database)/documents/bills/$(billId);

      let before = get(billPath).data;
      let after = getAfter(billPath).data;

      return before.vetId == request.auth.uid
      && after.vetId == before.vetId
      && after.patientId == before.patientId
      && after.lastPaymentId == paymentId
      && before.get("lastPaymentId", "") != paymentId
      && after.amountPaid > before.amountPaid
      && after.amountPaid <= after.amount
      && after.paymentMethod == request.resource.data.method
      && after.updatedAt == request.resource.data.createdAt
      && after.amountPaid - before.amountPaid
      > request.resource.data.amount - 0.000001
      && after.amountPaid - before.amountPaid
      < request.resource.data.amount + 0.000001;
    }

    // =====================================================
    // 3. USER ACCOUNTS
    // =====================================================

    match /users/{userId} {

      // Users may access only their own profile.
      allow get: if signedIn()
      && request.auth.uid == userId;

      // No account directory or email-based user searching.
      allow list: if false;

      // Users cannot approve their own veterinarian account.
      allow create: if signedIn()
      && request.auth.uid == userId
      && request.resource.data.uid == userId
      && request.resource.data.email is string
      && request.resource.data.role in [
        "veterinarian", "pet_owner"
      ]
      && request.resource.data.keys().hasOnly([
        "uid", "email", "role"
      ]);

      allow update, delete: if false;
    }

    // =====================================================
    // 4. SECURE PET-OWNER LINKING HELPER
    // =====================================================

    // This helper runs when the owner attempts to set
    // ownerId on a pet.
    //
    // It verifies that a matching pending invitation is
    // accepted in the SAME atomic Firestore batch.
    function validAcceptedOwnerLink(patientId) {
      let linkPath =
      /databases/$(database)/documents/petLinkRequests/$(patientId);

      return isPetOwner()
      && hasVerifiedEmail()

      // The pet must not already belong to someone.
      && resource.data.get("ownerId", "") == ""

      // The owner may only change ownerId.
      && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(["ownerId"])
      && request.resource.data.ownerId == request.auth.uid

      // Check the existing invitation.
      && exists(linkPath)
      && get(linkPath).data.id == patientId
      && get(linkPath).data.patientId == patientId
      && get(linkPath).data.vetId == resource.data.vetId
      && get(linkPath).data.status == "pending"
      && isIntendedOwner(get(linkPath).data.ownerEmail)

      // Check that the invitation is accepted
      // in the same batch as the ownerId update.
      && getAfter(linkPath).data.status == "accepted"
      && getAfter(linkPath).data.ownerUid == request.auth.uid
      && getAfter(linkPath).data.acceptedAt == request.time;
    }

    // =====================================================
    // 5. PATIENTS
    // =====================================================

    match /pets/{patientId} {

      // Vet reads own patients.
      // Pet owner reads only linked patients.
      allow read: if (
        isVet()
        && resource.data.vetId == request.auth.uid
      ) || (
        isPetOwner()
        && resource.data.get("ownerId", "") == request.auth.uid
      );

      allow create: if isVet()
      && request.resource.data.id == patientId
      && request.resource.data.vetId == request.auth.uid
      && request.resource.data.ownerId == "";

      // Vet edits remain limited to clinical details.
      // Pet owners can only set ownerId through
      // the secure acceptance transaction.
      allow update: if (
        isVet()
        && resource.data.vetId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
          "petName", "species", "breed", "age",
          "sex", "ownerName", "ownerPhone", "notes"
        ])
      ) || validAcceptedOwnerLink(patientId);

      allow delete: if false;

      // MEDICAL RECORDS

      match /medicalRecords/{recordId} {

        allow read: if vetOwnsPet(patientId)
        || ownerOwnsPet(patientId);

        allow create: if vetOwnsPet(patientId)
        && request.resource.data.patientId == patientId
        && request.resource.data.vetId == request.auth.uid
        && request.resource.data.id == recordId;

        allow update, delete: if false;
      }
    }

    // =====================================================
    // 6. PET-OWNER LINKING REQUESTS
    // =====================================================

    // Document structure:
    //
    // petLinkRequests/{patientId}
    //
    // id
    // patientId
    // vetId
    // ownerEmail
    // status
    // createdAt
    // petName
    // species
    // breed
    //
    // Pet preview details are copied from the patient
    // so an unlinked owner never needs to read the
    // private pets collection before accepting.

    match /petLinkRequests/{patientId} {

      function petPath() {
        return /databases/$(database)/documents/pets/$(patientId);
      }

      // Only the assigned vet or the verified intended
      // owner may view an invitation.
      allow get, list: if (
        isVet()
        && resource.data.vetId == request.auth.uid
      ) || isIntendedOwner(resource.data.ownerEmail);

      // VETERINARIAN SENDS AN INVITATION
      allow create: if isVet()

      // Vet must own an existing, unlinked pet.
      && exists(petPath())
      && get(petPath()).data.vetId == request.auth.uid
      && get(petPath()).data.get("ownerId", "") == ""

      // Require exactly these nine fields.
      // This fixes the mismatch found by our emulator.
      && request.resource.data.keys().hasAll([
        "id", "patientId", "vetId",
        "ownerEmail", "status", "createdAt",
        "petName", "species", "breed"
      ])
      && request.resource.data.keys().hasOnly([
        "id", "patientId", "vetId",
        "ownerEmail", "status", "createdAt",
        "petName", "species", "breed"
      ])

      // Request identity must match its document ID.
      && request.resource.data.id == patientId
      && request.resource.data.patientId == patientId
      && request.resource.data.vetId == request.auth.uid

      // Email must be lowercase and plausibly formatted.
      && request.resource.data.ownerEmail is string
      && request.resource.data.ownerEmail.size() > 3
      && request.resource.data.ownerEmail.size() <= 254
      && request.resource.data.ownerEmail.matches(
        "^[^@ ]+@[^@ ]+[.][^@ ]+$"
      )
      && request.resource.data.ownerEmail ==
      request.resource.data.ownerEmail.lower()

      // Prevent forged pet-preview information.
      && request.resource.data.petName ==
      get(petPath()).data.petName
      && request.resource.data.species ==
      get(petPath()).data.species
      && request.resource.data.breed ==
      get(petPath()).data.breed

      // Only pending requests can be created.
      && request.resource.data.status == "pending"
      && request.resource.data.createdAt == request.time;

      // PET OWNER ACCEPTS OR DECLINES
      allow update: if (

        // ACCEPT:
        // The matching pet must acquire this owner's UID
        // in the same atomic batch.
        isIntendedOwner(resource.data.ownerEmail)
        && resource.data.status == "pending"
        && resource.data.patientId == patientId

        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
          "status", "ownerUid", "acceptedAt"
        ])
        && request.resource.data.status == "accepted"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.acceptedAt == request.time

        && exists(petPath())
        && get(petPath()).data.vetId == resource.data.vetId
        && get(petPath()).data.get("ownerId", "") == ""
        && getAfter(petPath()).data.ownerId == request.auth.uid

      ) || (

        // DECLINE:
        // No changes to patient ownership.
        isIntendedOwner(resource.data.ownerEmail)
        && resource.data.status == "pending"

        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
          "status", "declinedAt"
        ])
        && request.resource.data.status == "declined"
        && request.resource.data.declinedAt == request.time
      );

      // An assigned vet may remove unresolved invitations
      // or declined invitations to send a corrected one.
      // Accepted links are retained for history.
      allow delete: if isVet()
      && resource.data.vetId == request.auth.uid
      && resource.data.status in [
        "pending", "declined"
      ];
    }

    // =====================================================
    // 7. APPOINTMENTS
    // =====================================================

    match /appointments/{appointmentId} {

      allow read: if (
        isVet()
        && resource.data.vetId == request.auth.uid
      ) || ownerOwnsPet(resource.data.patientId);

      allow create: if isVet()
      && request.resource.data.id == appointmentId
      && request.resource.data.vetId == request.auth.uid
      && vetOwnsPet(request.resource.data.patientId);

      allow update: if isVet()
      && resource.data.vetId == request.auth.uid
      && vetOwnsPet(resource.data.patientId)
      && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly([
        "scheduledAt", "status", "reason", "notes"
      ])
      && request.resource.data.status in [
        "scheduled", "completed", "cancelled"
      ];

      allow delete: if false;
    }

    // =====================================================
    // 8. BILLS
    // =====================================================

    match /bills/{billId} {

      allow read: if (
        isVet()
        && resource.data.vetId == request.auth.uid
      ) || ownerOwnsPet(resource.data.patientId);

      allow create: if isVet()
      && request.resource.data.id == billId
      && request.resource.data.vetId == request.auth.uid
      && vetOwnsPet(request.resource.data.patientId)
      && request.resource.data.amount > 0
      && request.resource.data.amountPaid == 0
      && request.resource.data.status == "unpaid"
      && request.resource.data.lastPaymentId == "";

      // Bill balance updates must have a corresponding
      // payment in the same atomic transaction.
      allow update: if isVet()
      && resource.data.vetId == request.auth.uid
      && vetOwnsPet(resource.data.patientId)
      && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly([
        "amountPaid", "status",
        "paymentMethod", "updatedAt", "lastPaymentId"
      ])
      && request.resource.data.amountPaid > resource.data.amountPaid
      && request.resource.data.amountPaid <= resource.data.amount
      && (
        (
          request.resource.data.amountPaid ==
          request.resource.data.amount
          && request.resource.data.status == "paid"
        ) || (
          request.resource.data.amountPaid <
          request.resource.data.amount
          && request.resource.data.status == "partial"
        )
      )
      && validBillPaymentUpdate(billId);

      allow delete: if false;

      // PAYMENT HISTORY

      match /payments/{paymentId} {

        allow read: if (
          isVet()
          && get(
            /databases/$(database)/documents/bills/$(billId)
          ).data.vetId == request.auth.uid
        ) || ownerOwnsPet(
          get(
            /databases/$(database)/documents/bills/$(billId)
          ).data.patientId
        );

        allow create: if isVet()
        && request.resource.data.id == paymentId
        && request.resource.data.billId == billId
        && request.resource.data.vetId == request.auth.uid
        && request.resource.data.amount > 0
        && request.resource.data.method in [
          "M-Pesa", "Cash", "Airtel Money"
        ]
        && validPaymentCreation(billId, paymentId);

        allow update, delete: if false;
      }
    }

    // All unspecified paths are denied by default.
  }
}
